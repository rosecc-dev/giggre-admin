# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Firebase extensions manifest — the SMTP connection URI param embeds the
# app password in plaintext, unlike the SMTP_PASSWORD secret param which
# stores only a Secret Manager reference here.
extensions/*.env
extensions/*.env.*
extensions/*.secret.*

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
